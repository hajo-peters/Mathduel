[sub_resource type="GDScript" id="GDScript_k4353"]
script/source = "class_name MainMenu
extends Control

@onready var button_3: Button = $VBoxContainer/TopBar/HBoxContainer/Button3
@onready var button_2: Button = $VBoxContainer/TopBar/HBoxContainer/Button2
@onready var button: Button = $VBoxContainer/TopBar/HBoxContainer/Button
@onready var h_box_container: HBoxContainer = $VBoxContainer/MainBody/HBoxContainer
@onready var new_game: Button = $NewGame
@onready var main_body: Control = $VBoxContainer/MainBody
@onready var main_body_overlay: Control = $VBoxContainer/MainBody/MainBodyOverlay
@onready var bar_list: MarginContainer = $VBoxContainer/BarList



var profile_page:PackedScene = preload(\"res://user_profile/profile.tscn\")
var message_page:PackedScene = preload(\"res://main_menu/messaging/messages.tscn\")
var friends_page:PackedScene = preload(\"res://main_menu/social/friends.tscn\")

var _tween: Tween
func set_hbox_offset(page_index:int):
	var page_width: float = get_viewport_rect().size.x
	var target_x: float = page_width * page_index
	if _tween and _tween.is_running():
		_tween.kill()
	
	_tween = create_tween().set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN_OUT)
	_tween.tween_property(h_box_container, \"position:x\", -target_x, 0.35)

func _on_active_pressed() -> void:
	set_hbox_offset(0)


func _on_open_pressed() -> void:
	set_hbox_offset(1)


func _on_history_pressed() -> void:
	set_hbox_offset(2)


var toggle_menu_page_view = false
var last_opened:PackedScene
var active_scene: PackedScene = null
var menu_page_instance: Node = null

func open_menu_page(scene: PackedScene) -> void:
	# Guard against unassigned PackedScenes in the inspector
	if scene == null:
		push_warning(\"Attempted to open a null PackedScene.\")
		return
	for child in main_body_overlay.get_children():
		child.queue_free()
	if is_instance_valid(menu_page_instance):
		
		menu_page_instance.queue_free()
		menu_page_instance = null
		if active_scene == scene:
			active_scene = null
			set_main_visible(true)
			return
	set_main_visible(false)
	active_scene = scene
	menu_page_instance = scene.instantiate()
	main_body_overlay.add_child(menu_page_instance)


func set_main_visible(visibility: bool) -> void:
	new_game.visible = visibility
	h_box_container.visible = visibility
	bar_list.visible = visibility


# Profile button
func _on_button_3_pressed() -> void:
	open_menu_page(profile_page)

# Messages button
func _on_button_2_pressed() -> void:
	open_menu_page(message_page)

# Friends :)
func _on_button_pressed() -> void:
	open_menu_page(friends_page)


func _on_new_game_pressed() -> void:
	get_tree().change_scene_to_file(\"res://main_menu/new_game/new_game.tscn\")
"

